{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-mobile",
    "version": "1.0.10",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.yoge.expensetracker",
      "buildNumber": "8",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "expensetracker",
              "com.googleusercontent.apps.487469737581-p826efhglp29u44vvo2cl4focntjg8e6"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to securely authenticate and access your Expense Tracker."
      }
    },
    "android": {
      "package": "com.yoge.expensetracker",
      "allowBackup": false,
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6EF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4AF37",
          "sounds": [
            "./assets/custom_chime.wav"
          ]
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1f8a984c-edd6-455d-9ba1-1832827887ac"
      }
    },
    "owner": "yoge-2004"
  }
}
