{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-mobile",
    "version": "1.0.3",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.yoge.expensetracker",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "expensetracker",
              "com.googleusercontent.apps.487469737581-p826efhglp29u44vvo2cl4focntjg8e6"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yoge.expensetracker",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6EF"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#D4AF37",
        "androidMode": "default",
        "androidCollapsedTitle": "ExpenseTracker"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.487469737581-p826efhglp29u44vvo2cl4focntjg8e6"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4AF37",
          "defaultChannel": "expense-reminders",
          "sounds": []
        }
      ]
    ],
    "scheme": "expensetracker",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f8a984c-edd6-455d-9ba1-1832827887ac"
      }
    },
    "owner": "yoge-2004"
  }
}
