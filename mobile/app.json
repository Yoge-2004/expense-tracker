{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.yoge.expensetracker",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "expensetracker",
              "com.googleusercontent.apps.487469737581-p826efhglp29u44vvo2cl4focntjg8e6"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.yoge.expensetracker",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0e14"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.487469737581-p826efhglp29u44vvo2cl4focntjg8e6"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "scheme": "expensetracker",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f8a984c-edd6-455d-9ba1-1832827887ac"
      }
    },
    "owner": "yoge-2004"
  }
}
